{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArtShot X Preview",
  "version": "0.7.1",
  "identifier": "org.artshotx.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:native && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:native && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ArtShot X",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Capture, annotate and record locally",
    "copyright": "Copyright 2026 ArtShot X contributors",
    "resources": {
      "resources/bin/": "bin/",
      "resources/THIRD-PARTY.txt": "THIRD-PARTY.txt",
      "resources/licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
